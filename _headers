# Cloudflare Pages response headers. /* also covers /scoreboard and the index.html fallback Pages serves for unknown paths.
# connect-src admits only the Wikipedia and Wikidata APIs. style-src needs 'unsafe-inline' for the <style> Font Awesome
# injects and for the inline styles in Wikipedia HTML, which documents parsed with DOMParser check against this policy.
# font-src admits jsDelivr for the Acme and Permanent Marker files. img-src needs data: for Pico's form icons.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src https://en.wikipedia.org https://www.wikidata.org; font-src https://cdn.jsdelivr.net; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
